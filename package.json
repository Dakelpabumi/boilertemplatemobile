{
  "name": "nextjs-capacitor-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js + Tailwind CSS + Capacitor boilerplate for shipping a static web app to Android.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out",
    "lint": "eslint .",
    "cap:sync": "npm run build && cap sync",
    "cap:copy": "npm run build && cap copy",
    "cap:resources": "capacitor-assets generate --android",
    "cap:android": "npm run cap:sync && node scripts/open-android.mjs",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^14.2.35",
    "serve": "^10.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
